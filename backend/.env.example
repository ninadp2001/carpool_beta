# Postgres connection (docker-compose exposes this on localhost:5432)
DATABASE_URL=postgresql+psycopg://carpool:carpool@localhost:5432/carpool

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Payments: "razorpay" uses the keys below (test mode keys start with rzp_test_),
# "mock" lets you complete payments with a button, for local demos without keys.
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# GST applied to rentals, washes and rides, as a fraction
GST_RATE=0.18

# First admin account, created by `python -m app.seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345

# Business timezone for "today", ride search dates and wash slots
TIMEZONE=Asia/Kolkata
